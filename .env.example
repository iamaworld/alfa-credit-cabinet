# Скопируйте в .env при необходимости. Все значения необязательны.
APP_PORT=3000
# Секрет подписи сессий. Для любого запуска вне демонстрации замените.
APP_SECRET=change-me-before-any-real-use
# 1 — создать тестовые аккаунты при старте, 0 — не создавать
SEED=1
# Пауза между этапами обработки заявки (мс): нужна, чтобы статус был виден в движении
STAGE_DELAY_MS=1800
# Таймаут и число повторов при обращении к источникам данных
ENRICH_TIMEOUT_MS=2000
ENRICH_RETRIES=1
# ИИ-помощник на локальной модели с открытыми весами (llama.cpp + Qwen3-1.7B). 0 — выключить, работает разбор по правилам
LLM_ENABLED=1
# Сколько ждать ответа модели, прежде чем перейти на разбор по правилам (мс)
LLM_TIMEOUT_MS=15000
